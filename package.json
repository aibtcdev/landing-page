{
  "name": "aibtcdev-landing-page",
  "private": true,
  "version": "1.45.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run wrangler -- deploy",
    "deploy:dry-run": "npm run wrangler -- deploy --dry-run",
    "wrangler": "set -a && . ./.env && set +a && npx wrangler",
    "cf-typegen": "npm run wrangler -- types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aibtc/tx-schemas": "^1.1.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@scure/base": "^2.0.0",
    "@scure/btc-signer": "^2.0.1",
    "@stacks/common": "^7.3.1",
    "@stacks/encryption": "^7.3.1",
    "@stacks/transactions": "^7.3.1",
    "date-fns": "^4.1.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.0",
    "x402-stacks": "^2.0.1"
  },
  "overrides": {
    "undici": ">=7.29.0",
    "flatted": ">=3.4.0",
    "picomatch": ">=4.0.4",
    "path-to-regexp": ">=8.4.0",
    "axios": ">=1.18.1",
    "ws": ">=8.21.0",
    "sharp": ">=0.35.4",
    "nanoid": ">=3.3.18 <4",
    "postcss": ">=8.5.23",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
